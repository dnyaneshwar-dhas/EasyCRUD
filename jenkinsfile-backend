pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')

    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/dnyaneshwar-dhas/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }

            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Artifact to s3') {
            steps {
                sh 'aws s3 cp backend/target/*.jar s3://dnyanu.space/Artifact/student.jar'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeENV('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
    }
}
