pipeline {
    agent {
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/dnyaneshwar-dhas/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }
        }
    }
}
