pipeline {
    agent {
        label "worker"

    }
    
    stages {
        stage('Checkout') {
            steps {
               git branch: 'main', url: 'https://github.com/dnyaneshwar-dhas/EasyCRUD.git'
            }
        }

        stage('Buid-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true

                }
            }
        }

        stage('Push artifacts to s3') {
            steps {
                sh '''
                aws s3 sync frontend/dist s3://dnyanu.space
                '''
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                    docker build -t frontend:latest
                    docker images
                    '''

                }
            }
        }

    }
}
