pipeline {
    agent {
        label "worker"

    }
    
    stages {
        stage('Checkout') {
            steps {
               git branch: 'main', url: 'https://github.com/dnyaneshwar-dhas/EasyCRUD.git'
            }
        }

        stage('Buid-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            
        }

    }
}
