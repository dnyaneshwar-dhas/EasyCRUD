pipeline {
    agent {
        label "worker"

    }

    environment {
         my_aws_cred = credentials('aws-cred')
         ECR_REPO = "872582135546.dkr.ecr.us-east-2.amazonaws.com/frontend"

    }
    
    stages {
        stage('Checkout') {
            steps {
               git branch: 'main', credentialsId: "github-cred", url: 'https://github.com/dnyaneshwar-dhas/EasyCRUD.git'
            }
        }

        stage('Buid-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                    npm install
                    npm run build
                    '''
                }
            }
            
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true

                }
            }
        }

        stage('Push artifacts to s3') {
            steps {
                sh '''
                aws s3 sync frontend/dist s3://dnyanu.space
                '''
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                    docker build -t frontend:${BUILD_NUMBER} .
                    docker images
                    '''

                }
            }
        }

        //stage('Trivy Image scanning') {
          //  steps {
            //    sh '''
              //     trivy image --scanner vuln --severity HIGH,CRITICAL --exit-code 0 frontend:${BUILD_NUMBER}
//
  //              '''
  //          }
    //    }

        stage('Approval') {
            steps {
                timeout(time: 30 , unit: "MINUTES") {
                    input message: 'Deployment to kubernetes', ok: 'Approve'
                }
            }
        }


        stage('Push image to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 872582135546.dkr.ecr.us-east-2.amazonaws.com
                docker tag frontend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                docker push ${ECR_REPO}:${BUILD_NUMBER}

                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/frontend/frontend-deployment.yaml
                '''
            }
        }

        stage("Push change to GITHUB") {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                ]) {
                    sh '''
                        git config user.name "dnyaneshwar-dhas"
                        git config user.email "dnyaneshwardhas2004@gmail.com"

                        git add k8s/frontend/frontend-deployment.yaml
                        git commit -m "Update frontend-deployment"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/dnyaneshwar-dhas/EasyCRUD.git HEAD:main
                    '''
                }
            }
        }

        stage('Update Argocd deployment') {
            steps {
                sh '''
                   sudo aws eks update-kubeconfig --name my-eks-cluster --region us-east-2
                   sudo kubectl apply -f argocd/frontend-application.yaml
                   sudo kubectl get application -n argocd
                   '''
            }
        } 

    }
}
